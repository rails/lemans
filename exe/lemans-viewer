    function saveFilters() { storage.write("lemans-viewer.filters", state.filters); }

    async function renderRunView(id) {
      const main = document.getElementById("main");
      main.classList.add("reading");
      if (!state.run || state.run.row.trial !== id) {
        main.replaceChildren(el("div", { class: "empty" }, "loading…"));
        try {
          state.run = await fetchJSON(`/api/runs/${encodeURIComponent(id)}`);
