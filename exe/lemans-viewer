      const fact = (k, v) => el("span", {}, el("span", { class: "k" }, k), v);
      const phases = (result.phases || []).map(p => {
        const secs = p.finished_at ? (new Date(p.finished_at) - new Date(p.started_at)) / 1000 : null;
